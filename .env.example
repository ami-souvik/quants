# ============================================================
# NSE LLM Trader — Environment Variables
# Copy to .env (never commit .env)
# ============================================================

# LLM APIs
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Local LLM fallback via Ollama
# Agents automatically fall back here when ANTHROPIC_API_KEY / GEMINI_API_KEY are empty.
# Set OLLAMA_BASE_URL to your Ollama server — local (default) or remote.
# Pull the model first on your server: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Broker (Phase 2 only — leave empty in Phase 1)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nse-llm-trader/1.0

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nse-llm-trader-archive
DYNAMO_TABLE_NAME=nse_trader

# DynamoDB endpoint override — for local development only.
# Leave empty in production (real AWS DynamoDB is used).
# When running Python directly against the Docker stack: http://localhost:8001
# When running inside docker-compose: set automatically by the compose file.
DYNAMO_ENDPOINT_URL=

# App
PAPER_TRADING_MODE=true
INITIAL_CAPITAL_INR=1000000
MAX_POSITION_PCT=0.15
MAX_OPEN_POSITIONS=5
MAX_HOLD_DAYS=5
CIRCUIT_BREAKER_DRAWDOWN=0.10
DAILY_LLM_BUDGET_USD=1.00

# FastAPI
API_KEY=changeme-local-dev
ENVIRONMENT=development

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO
# Path to rotating log file (10 MB × 5 backups).
# Inside Docker this resolves to /app/logs/trader.log, bind-mounted to ./logs/ on the host.
# Set to "" to write to console only.
LOG_FILE=logs/trader.log

# Dry-run (generates no real fills, skips DynamoDB writes)
DRY_RUN=false
