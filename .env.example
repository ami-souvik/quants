# ============================================================
# NSE LLM Trader — Environment Variables
# Copy to .env (never commit .env)
# ============================================================

# LLM APIs
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Agent model configuration
# Use prefixes: "google/" for Gemini, "anthropic/" for Claude, "ollama/" for local.
# Falls back to Ollama automatically when the corresponding API key is missing.
AGENT_MODEL_NEWS_SENTIMENT=google/gemini-2.5-flash
AGENT_MODEL_TECHNICAL=google/gemini-2.5-flash
AGENT_MODEL_FUNDAMENTALS=google/gemini-2.5-flash
AGENT_MODEL_BULL_BEAR=google/gemini-2.5-flash
AGENT_MODEL_PORTFOLIO_MANAGER=google/gemini-2.5-flash
AGENT_MODEL_PORTFOLIO_MANAGER_ESCALATION=google/gemini-2.5-flash

# Schema retry on validation failure.
# true  (default) — retry the LLM call once when Pydantic rejects the output.
# false — log the error and stop immediately; set to false when using native
#         structured output (Gemini response_schema / Anthropic tool_choice)
#         since retries are wasted calls if the schema itself is the problem.
AGENT_SCHEMA_RETRY_ENABLED=false

# Local LLM fallback via Ollama
# Agents automatically fall back here when ANTHROPIC_API_KEY / GEMINI_API_KEY are empty.
# Set OLLAMA_BASE_URL to your Ollama server — local (default) or remote.
# OLLAMA_MODEL must match a model you have pulled on that server.
#   Check what's available: curl http://<server>:11434/api/tags
#   Pull a model:           ollama pull gemma3:4b
# OLLAMA_READ_TIMEOUT: seconds to wait for inference. Large models on slow hardware
#   need more time. gemma4 on a mid-range server typically takes 60–180 s per call.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_READ_TIMEOUT=300

# Broker (Phase 2 only — leave empty in Phase 1)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nse-llm-trader/1.0

# Database (Supabase PostgreSQL / Neon / Local Postgres)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Caching (Upstash Redis or Local Redis)
# Format: rediss://default:[PASSWORD]@[HOST]:[PORT]
REDIS_URL=redis://localhost:6379

# Authentication (Better Auth)
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_here
BETTER_AUTH_URL=http://localhost:3000

# App
PAPER_TRADING_MODE=true
INITIAL_CAPITAL_INR=1000000
MAX_POSITION_PCT=0.15
MAX_OPEN_POSITIONS=5
MAX_HOLD_DAYS=5
CIRCUIT_BREAKER_DRAWDOWN=0.10
DAILY_LLM_BUDGET_USD=1.00

# FastAPI & Dashboard
API_KEY=changeme-local-dev
NEXT_PUBLIC_API_KEY=changeme-local-dev
ENVIRONMENT=development
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trader.log

# Dry-run (generates no real fills, skips DB writes)
DRY_RUN=false
